# Top-level versions for the full paper run on Google Colab (Tesla T4).
# The full lock installed by scripts/run_all.sh is requirements-colab.txt, generated from this file with:
#   uv pip compile requirements-colab.in --python-version 3.12 --python-platform x86_64-manylinux_2_35 \
#       --index-strategy unsafe-best-match --emit-index-url -o requirements-colab.txt
# torch builds come from the PyTorch CUDA 12.8 index; everything else from PyPI.
--extra-index-url https://download.pytorch.org/whl/cu128
